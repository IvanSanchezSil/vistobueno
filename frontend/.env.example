# Copiar a .env.local (desarrollo) o inyectar en CI (build)
# Vacío (default) = mismo origen → requiere proxy (vite dev) o reverse proxy (producción).
# Con valor = origen absoluto de la API, p.ej. https://api.ejemplo.com
VITE_API_URL=

# Token compartido del buzón (opcional). El backend (PR #66) exige el header
# `X-VistoBueno-Token` cuando define VISTOBUENO_API_TOKEN. Vacío (default) =
# la SPA habla sin header, que es lo correcto en loopback (la SPA y el
# userscript corren en la misma máquina). Definirlo solo si la API se expone
# fuera de esa máquina.
VITE_API_TOKEN=

* text=auto

# Normalizar a LF para evitar diffs espurios por finales de línea CRLF/LF
*.py text eol=lf
*.nix text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.txt text eol=lf

# Scripts de Windows: CRLF para cmd.exe y PowerShell
*.bat text eol=crlf
*.ps1 text eol=crlf
